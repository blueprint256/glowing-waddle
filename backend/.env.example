# Server Configuration
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/campaign_management

# Session Secret
SESSION_SECRET=your-super-secret-session-key-change-in-production

# CORS
FRONTEND_URL=http://localhost:3000

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=campaign-management-assets
# Leave unset for buckets with ACLs disabled (the AWS default). Uploaded images are then
# made readable via a bucket policy. Set to public-read only if your bucket allows ACLs.
# S3_OBJECT_ACL=public-read

# Google OAuth2 Configuration
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# Canva Integration
CANVA_CLIENT_ID=your-canva-client-id
CANVA_CLIENT_SECRET=your-canva-client-secret
CANVA_CALLBACK_URL=

# OpenAI API Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7
# AI image quality (gpt-image-1.5): low (~$0.01 a picture), medium (default, ~$0.03), high (~$0.13) or auto.
# IMAGE_QUALITY=medium

# Encryption Key for sensitive data (e.g., API keys in database)
# IMPORTANT: In production, use a strong 32-character random string
ENCRYPTION_KEY=default-32-char-encryption-key!!

# ---------------------------------------------------------------------------
# Claude connector (MCP) — see docs/MCP_CONNECTOR.md
# ---------------------------------------------------------------------------
# Public HTTPS address of THIS backend, as Claude will reach it (no trailing slash).
# Local testing: the URL of your tunnel, e.g. https://abc-123.trycloudflare.com
# The connector URL you paste into Claude is then  <MCP_PUBLIC_URL>/mcp
MCP_PUBLIC_URL=
# Which proxies to trust for client IP / https detection. Default "loopback" suits a tunnel
# running on this machine. Use a hop count (e.g. 1) behind a hosted load balancer.
# TRUST_PROXY=loopback
# Optional: comma-separated browser origins allowed to call /mcp (unset = any origin; tokens are still required)
# MCP_ALLOWED_ORIGINS=
# Optional token lifetimes (seconds)
# MCP_ACCESS_TOKEN_TTL_SECONDS=3600
# MCP_REFRESH_TOKEN_TTL_SECONDS=2592000

# API rate limit: requests per IP per 15 minutes (Library pages load many thumbnails; file links are exempt)
# API_RATE_LIMIT_PER_15_MIN=1500

# Publishing (social posting) — platform app keys are entered in Settings → Integrations (System Admin),
# not here. Platforms send users back to <MCP_PUBLIC_URL>/api/publishing/oauth/<platform>/callback,
# so MCP_PUBLIC_URL must be your public https address. Set PUBLISHING_WORKER=off to disable the
# scheduler on a server instance (e.g. when running several).
# PUBLISHING_WORKER=on

# Canva: optional here; the Canva client ID/secret can also be entered in Settings → Integrations.
# Leave CANVA_CALLBACK_URL empty to use <MCP_PUBLIC_URL>/api/integrations/canva/callback.

# Inbox: time zone used in reminder titles ("goes out tomorrow at 09:00"). Set INBOX_WORKER=off on
# server instances that shouldn't run the reminder rules.
# APP_TIMEZONE=Africa/Kampala
# INBOX_WORKER=on

# Designed posters (docs/DESIGN_ENGINE.md). The renderer needs Chromium: `npx playwright install
# chromium`, or point DESIGN_CHROME_PATH at a system Chrome. DESIGN_WORKER=off on instances that
# shouldn't make posters. Cut-out people need `npm install onnxruntime-node` and a model file.
# DESIGN_CHROME_PATH=/usr/bin/google-chrome
# DESIGN_WORKER=on
# DESIGN_WORKER_CONCURRENCY=1
# CUTOUT_MODEL=/opt/models/birefnet-lite.onnx
# CUTOUT_MODEL_KIND=birefnet
